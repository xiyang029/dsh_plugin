{
  "name": "dsh-plugin-prompt-injection",
  "version": "1.0.0",
  "type": "module",
  "description": "在侧边栏编辑一段自定义指令，持久化后注入到每一轮请求的系统提示词中。",
  "meta": {
    "title": "提示词注入",
    "description": "编辑并持久化一段注入到每轮系统提示词的自定义指令。"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locales/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "atomic-write.js",
    "cordis.patch.yml",
    "locales/*.json"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
